__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.DS_Store
results/*
!results/.gitkeep

# Piloto T5.1: resultados agregados pequeños y procedencia revisables en el PR.
!results/pilot/
results/pilot/*
!results/pilot/kpis.csv
!results/pilot/audit.csv
!results/pilot/zones.csv
!results/pilot/summary.csv
!results/pilot/comparisons.csv
!results/pilot/precision.csv
!results/pilot/manifest.json
!results/pilot/groups.csv

# T5.3: solo agregados y procedencia; checkpoints quedan locales.
!results/final/
results/final/*
!results/final/*.csv
!results/final/manifest.json
!results/final/pilot/
results/final/pilot/*
!results/final/pilot/*.csv

# T6.1: figuras definitivas y valores dibujados; sin checkpoints.
!results/figures/
results/figures/*
!results/figures/*.png
!results/figures/*.svg
!results/figures/statistics.csv
!results/figures/manifest.json
